{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prisonerlegalaid-blog",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  // Permanent video list shared with prisonerlegalaid.com (2026-10-17).
  "kv_namespaces": [
    { "binding": "VIDEO_LIST", "id": "637919ee985a4d99ab1d512993b953e7" }
  ]
}
