---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
{#-
  IMPORTANT: this iterates collections.posts, NOT collections.all.
  .eleventy.js drip-publishes by filtering future-dated posts out of that
  collection — but Eleventy still WRITES those pages to disk, so they are
  live at their URL, merely unlisted. Iterating collections.all would submit
  the unpublished drip queue to Google. Verified 2026-08-22.
-#}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- set site = "https://prisonerlegalaid.blog" -%}
{#-
  lastmod truthfulness (P0.2): previously EVERY static page emitted
  `newestPostDate`, so publishing any single article falsely told search
  engines that the homepage, pricing, terms, privacy and every tool page had
  just been updated. Each page now carries its own `pageModified:` front
  matter (seeded from real git history) and the sitemap reads that value.
  Acceptance test: publishing an article must not change any other page's
  lastmod.
-#}
{%- macro lastmodFor(url) -%}
{%- set found = "" -%}
{%- for p in collections.all -%}
{%- if p.url == url and p.data.pageModified -%}{%- set found = p.data.pageModified | dateISO -%}{%- endif -%}
{%- endfor -%}
{{ found }}
{%- endmacro -%}
  <url>
    <loc>{{ site }}/</loc>
    <lastmod>{{ lastmodFor("/") }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ site }}/litigation/</loc>
    <lastmod>{{ lastmodFor("/litigation/") }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>{{ site }}/case-file/</loc>
    <lastmod>{{ lastmodFor("/case-file/") }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>{{ site }}/pricing/</loc>
    <lastmod>{{ lastmodFor("/pricing/") }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>{{ site }}/transfer-request/</loc>
    <lastmod>{{ lastmodFor("/transfer-request/") }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ site }}/forms/</loc>
    <lastmod>{{ lastmodFor("/forms/") }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
{%- for h in hubs %}
  <url>
    <loc>{{ site }}/topics/{{ h.slug }}/</loc>
    <lastmod>{{ h.modified }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
{%- endfor %}
  <url>
    <loc>{{ site }}/about-the-author/</loc>
    <lastmod>{{ lastmodFor("/about-the-author/") }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>{{ site }}/editorial-standards/</loc>
    <lastmod>{{ lastmodFor("/editorial-standards/") }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>{{ site }}/free-tools/</loc>
    <lastmod>{{ lastmodFor("/free-tools/") }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ site }}/case-file-checklist/</loc>
    <lastmod>{{ lastmodFor("/case-file-checklist/") }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>{{ site }}/privacy/</loc>
    <lastmod>{{ lastmodFor("/privacy/") }}</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>{{ site }}/blog/</loc>
    <lastmod>{{ lastmodFor("/blog/") }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
{%- for post in collections.posts %}
  <url>
    <loc>{{ site }}{{ post.url }}</loc>
    <lastmod>{{ post.date | dateISO }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
{%- endfor %}
</urlset>
