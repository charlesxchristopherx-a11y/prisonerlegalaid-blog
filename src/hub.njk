---
pagination:
  data: hubs
  size: 1
  alias: hub
permalink: "/topics/{{ hub.slug }}/"
layout: base.njk
eleventyComputed:
  title: "{{ hub.title }} | Writ Large"
  description: "{{ hub.description }}"
  pageModified: "2026-09-04"
---
{#- Hub page: the parent for every core article on this subject. Generated
    from src/_data/hubs.js, with children resolved by each post's `hub:`
    front matter, so a new post joins its hub automatically. -#}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ hub.title | dump | safe }},
  "description": {{ hub.description | dump | safe }},
  "url": "https://prisonerlegalaid.blog/topics/{{ hub.slug }}/",
  "isPartOf": { "@id": "https://prisonerlegalaid.blog/#organization" }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://prisonerlegalaid.blog/" },
    { "@type": "ListItem", "position": 2, "name": "Federal Post-Conviction", "item": "https://prisonerlegalaid.blog/blog/" },
    { "@type": "ListItem", "position": 3, "name": {{ hub.crumb | dump | safe }}, "item": "https://prisonerlegalaid.blog/topics/{{ hub.slug }}/" }
  ]
}
</script>

<div class="page-head">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb" style="font-size:14px;color:#5b6470;margin:0 0 8px">
      <a href="/" style="color:#5b6470">Home</a> ›
      <a href="/blog/" style="color:#5b6470">Federal Post-Conviction</a> ›
      <a href="/topics/" style="color:#5b6470">Topics</a> ›
      <span aria-current="page">{{ hub.crumb }}</span>
    </nav>
    <p class="eyebrow">Topic Hub</p>
    <h1>{{ hub.label }}</h1>
  </div>
</div>

<section class="wrap" style="max-width:900px;padding:0 20px 40px">
  <p style="font-size:17px;line-height:1.75;color:#39414B;max-width:66ch">{{ hub.intro }}</p>

  {% if hub.form %}
  <p style="margin:20px 0 0">
    <a class="btn-primary" href="{{ hub.form.href }}" download style="display:inline-block;background:#14181f;color:#fff;padding:11px 17px;border-radius:4px;text-decoration:none;font-size:15px;font-weight:600">{{ hub.form.label }}</a>
    <a href="/forms/" style="margin-left:12px;font-size:15px">All federal court forms →</a>
  </p>
  {% else %}
  <p style="margin:18px 0 0;font-size:15px"><a href="/forms/">Browse official federal court forms →</a></p>
  {% endif %}

  <h2 style="font-size:22px;margin:38px 0 16px">Articles in this topic</h2>
  <div class="posts">
    {%- set items = [] -%}
    {%- for post in collections.posts -%}
      {%- if post.data.hub == hub.key -%}{%- set items = (items.push(post), items) -%}{%- endif -%}
    {%- endfor -%}
    {% for post in items %}
    <a class="post" href="{{ post.url }}">
      <span class="kicker">{{ post.data.category }} · {{ post.date | dateDisplay }}</span>
      <h3>{{ post.data.title }}</h3>
      <p>{{ post.data.description }}</p>
      <span class="more">Read the post &rarr;</span>
    </a>
    {% endfor %}
    {% if items.length == 0 %}<p style="color:#5b6470">Articles in this topic are being published on a rolling schedule.</p>{% endif %}
  </div>

  <h2 style="font-size:22px;margin:38px 0 12px">Other topics</h2>
  <p style="margin:0 0 6px;font-size:15px"><a href="/topics/">All topics &rarr;</a></p>
  <p style="font-size:16px;line-height:1.9">
    {% for h in hubs %}{% if h.key != hub.key %}<a href="/topics/{{ h.slug }}/">{{ h.label }}</a>{% if not loop.last %} · {% endif %}{% endif %}{% endfor %}
  </p>

  <div class="post-cta" style="margin-top:32px">
    <strong>Need a document prepared?</strong> Call <a href="tel:+17864085073">786-408-5073</a> or email <a href="mailto:info@prisonerlegalaid.com">info@prisonerlegalaid.com</a>.
  </div>
  <p style="font-size:14px;color:#5b6470;line-height:1.7;margin:22px 0 0"><em>General educational information, not legal advice. This material does not create an attorney-client relationship.</em></p>
</section>
