---
pagination:
  data: checklists
  size: 1
  alias: cl
permalink: "/checklists/{{ cl.slug }}/"
layout: base.njk
eleventyComputed:
  title: "{{ cl.title }} | Writ Large"
  description: "{{ cl.description }}"
  pageModified: "{{ cl.modified }}"
---
{#- One page per entry in src/_data/checklists.js. Adding a checklist is a
    data change, not a template change -- same contract as hub.njk.

    These are original checklists ABOUT the official forms. Nothing here
    reproduces or reformats a government form; where a form applies, the
    page links the official unmodified PDF served from /forms/. -#}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": {{ cl.title | dump | safe }},
  "description": {{ cl.description | dump | safe }},
  "url": "https://prisonerlegalaid.blog/checklists/{{ cl.slug }}/",
  "isPartOf": { "@id": "https://prisonerlegalaid.blog/#organization" },
  "step": [
{%- for s in cl.sections %}
    { "@type": "HowToSection", "name": {{ s.heading | dump | safe }}, "position": {{ loop.index }} }{% if not loop.last %},{% endif %}
{%- endfor %}
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://prisonerlegalaid.blog/" },
    { "@type": "ListItem", "position": 2, "name": "Checklists", "item": "https://prisonerlegalaid.blog/checklists/" },
    { "@type": "ListItem", "position": 3, "name": {{ cl.label | dump | safe }}, "item": "https://prisonerlegalaid.blog/checklists/{{ cl.slug }}/" }
  ]
}
</script>

<div class="page-head">
  <div class="wrap">
    <p class="eyebrow">Filing checklist</p>
    <h1>{{ cl.title }}</h1>
  </div>
</div>

<section class="wrap" style="max-width:900px;padding:0 20px 40px">
  <nav class="crumbs" aria-label="Breadcrumb" style="font-size:14px;color:#5b6470;margin:0 0 18px">
    <a href="/" style="color:#5b6470">Home</a> &rsaquo;
    <a href="/checklists/" style="color:#5b6470">Checklists</a> &rsaquo;
    <span aria-current="page">{{ cl.label }}</span>
  </nav>

  <div style="border-left:3px solid #14181f;background:#f6f7f9;padding:16px 18px;margin:0 0 28px;border-radius:0 4px 4px 0">
    <p style="margin:0;font-size:17px;line-height:1.65;color:#14181f">{{ cl.intro | safe }}</p>
  </div>

  {%- if cl.form %}
  <p style="font-size:16px;line-height:1.7;margin:0 0 28px"><strong>The form you need:</strong>
    <a href="{{ cl.form.href }}" download>{{ cl.form.label }}</a> &mdash; the official fillable PDF, unmodified. See the
    <a href="/forms/">forms library</a> for the issuing authority's page.</p>
  {%- endif %}

  {%- for s in cl.sections %}
  <h2 style="font-size:21px;margin:30px 0 10px">{{ s.heading }}</h2>
  <ul style="font-size:16px;line-height:1.85;color:#39414B;padding-left:22px;margin:0">
    {%- for i in s.items %}
    <li style="margin:0 0 8px">{{ i | safe }}</li>
    {%- endfor %}
  </ul>
  {%- endfor %}

  <section class="post-authority" style="margin:36px 0 0;padding:20px;border:1px solid rgba(20,24,31,.14);border-radius:6px;background:#f6f7f9">
    <p style="margin:0 0 10px;font-size:14px;letter-spacing:.04em;text-transform:uppercase;color:#5b6470">Primary authority</p>
    <ul style="margin:0;padding-left:20px;font-size:16px;line-height:1.9">
      {%- for a in cl.authorities %}
      <li><a href="{{ a.url }}" rel="noopener" target="_blank">{{ a.cite }}</a></li>
      {%- endfor %}
    </ul>
    <p style="margin:12px 0 0;font-size:14px;line-height:1.6;color:#5b6470">Every item on this page was checked against the sources above before publication &mdash; see our <a href="/editorial-standards/">editorial standards</a>.</p>
  </section>

  <div class="post-cta" style="margin-top:30px">
    <strong>Need the document prepared?</strong> Call <a href="tel:+17864085073">786-408-5073</a> or email
    <a href="mailto:info@prisonerlegalaid.com">info@prisonerlegalaid.com</a>.
  </div>
  <p style="font-size:14px;color:#5b6470;line-height:1.7;margin:22px 0 0"><em>General educational information, not legal advice, and not a prediction of any outcome. Deadlines and local rules vary by district &mdash; confirm them against your own court's rules and your own record. This material does not create an attorney-client relationship.</em></p>
</section>
