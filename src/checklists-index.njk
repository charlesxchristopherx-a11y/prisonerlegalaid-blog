    dead for a day. -#}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Federal Filing Checklists",
  "description": {{ description | dump | safe }},
  "url": "https://prisonerlegalaid.blog/checklists/",
  "isPartOf": { "@id": "https://prisonerlegalaid.blog/#organization" },
  "hasPart": [
{%- for c in checklists %}
    { "@type": "HowTo", "name": {{ c.title | dump | safe }}, "url": "https://prisonerlegalaid.blog/checklists/{{ c.slug }}/" }{% if not loop.last %},{% endif %}
{%- endfor %}
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
