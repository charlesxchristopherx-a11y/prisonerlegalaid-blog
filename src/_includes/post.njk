---
layout: base.njk
---
{# Article + FAQ schema. Structured data is one of the strongest documented
   signals for AI retrieval systems (ChatGPT Search, Perplexity, Google AI
   Overviews) deciding what to cite. Added 2026-09-02.
   `answer` and `faq` are optional front-matter fields on any post. #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "datePublished": "{{ page.date | dateISO }}",
  {#- dateModified reflects a real substantive revision, set via an optional
      `modified:` front-matter field. It must NOT change merely because a
      build ran -- the daily rebuild would otherwise mark every article as
      freshly updated, which is a false freshness signal to search engines. -#}
  "dateModified": "{% if modified %}{{ modified | dateISO }}{% else %}{{ page.date | dateISO }}{% endif %}",
  "articleSection": {{ category | dump | safe }},
  "inLanguage": "en-US",
  "isAccessibleForFree": true,
  {#- author is a Person, not the Organization. For a legal-information
      site, naming the actual human who researched the piece is the point of
      the signal; the Organization remains the publisher. Person data is
      truthful: a certified paralegal, explicitly not an attorney. -#}
  "author": {
    "@type": "Person",
    "@id": "https://prisonerlegalaid.blog/about-the-author/#person",
    "name": "C. Christopher",
    "jobTitle": "Certified Paralegal",
    "url": "https://prisonerlegalaid.blog/about-the-author/",
    "worksFor": { "@id": "https://prisonerlegalaid.blog/#organization" }
  },
  "publisher": { "@id": "https://prisonerlegalaid.blog/#organization" },
  {#- No schema reviewedBy. Attorney review DOES occur before publication, but
      schema.org reviewedBy expects a named Person or Organization, and
      reviewing attorneys are deliberately not named -- naming one alongside
      legal information can imply representation that does not exist. The
      review is stated in visible prose instead of asserted as a machine
      claim about a party we will not identify. -#}
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://prisonerlegalaid.blog{{ page.url }}"
  }{% if answer %},
  "abstract": {{ answer | dump | safe }}{% endif %}
}
</script>
{% if faq %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in faq %}{
      "@type": "Question",
      "name": {{ item.q | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} }
    }{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
</script>
{% endif %}
{%- set myHub = null -%}
{%- for h in hubs -%}{%- if h.key == hub -%}{%- set myHub = h -%}{%- endif -%}{%- endfor -%}
{% if myHub %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://prisonerlegalaid.blog/" },
    { "@type": "ListItem", "position": 2, "name": "Federal Post-Conviction", "item": "https://prisonerlegalaid.blog/blog/" },
    { "@type": "ListItem", "position": 3, "name": {{ myHub.crumb | dump | safe }}, "item": "https://prisonerlegalaid.blog/topics/{{ myHub.slug }}/" },
    { "@type": "ListItem", "position": 4, "name": {{ title | dump | safe }}, "item": "https://prisonerlegalaid.blog{{ page.url }}" }
  ]
}
</script>
{% endif %}
<article class="post-body">
  {% if myHub %}
  <nav class="crumbs" aria-label="Breadcrumb" style="font-size:14px;color:#5b6470;margin:0 0 14px">
    <a href="/" style="color:#5b6470">Home</a> ›
    <a href="/blog/" style="color:#5b6470">Federal Post-Conviction</a> ›
    <a href="/topics/{{ myHub.slug }}/" style="color:#5b6470">{{ myHub.crumb }}</a>
  </nav>
  {% endif %}
  <p class="kicker">{{ category }}</p>
  <h1>{{ title }}</h1>
  <p class="meta">Writ Large · {{ page.date | dateDisplay }}{% if modified %} · Last reviewed {{ modified | dateDisplay }}{% endif %}</p>
  <p class="byline" style="font-size:15px;color:#5b6470;margin:-6px 0 22px">
    Written by <a href="/about-the-author/" style="color:#14181f;font-weight:600">C. Christopher, Certified Paralegal</a>
    · <a href="/editorial-standards/" style="color:#5b6470">Attorney-reviewed before publication</a>
  </p>
  {% if answer %}
  {# Answer-first block. AI retrieval chunks pages and strongly favors a
     direct, self-contained answer near the top over a narrative that builds
     to it. Renders as a visually distinct summary for human readers too. #}
  <div class="answer-block" style="border-left:3px solid #14181f;background:#f6f7f9;padding:16px 18px;margin:0 0 26px;border-radius:0 4px 4px 0">
    <p style="margin:0;font-size:17px;line-height:1.65;color:#14181f"><strong>Short answer:</strong> {{ answer }}</p>
  </div>
  {% endif %}
  {{ content | safe }}
  {% if faq %}
  <section class="post-faq" style="margin:36px 0 0">
    <h2 style="font-size:22px;margin:0 0 16px">Common questions</h2>
    {% for item in faq %}
    <div style="margin:0 0 20px">
      <h3 style="font-size:17px;margin:0 0 6px">{{ item.q }}</h3>
      <p style="margin:0;font-size:16px;line-height:1.7;color:#39414B">{{ item.a }}</p>
    </div>
    {% endfor %}
  </section>
  {% endif %}
  {% if authorities %}
  {# P1.11 -- primary authority, presented the same way on every article.
     Each entry links the official source: uscode.house.gov for statutes,
     supremecourt.gov for slip opinions with no U.S. Reports page yet, and
     CourtListener for reported decisions. Curated, not exhaustive: these
     are the authorities the article actually rests on. Enforced by
     tools/authority-audit.js, which fails if a hub article has none. #}
  <section class="post-authority" style="margin:36px 0 0;padding:20px;border:1px solid rgba(20,24,31,.14);border-radius:6px;background:#f6f7f9">
    <p style="margin:0 0 10px;font-size:14px;letter-spacing:.04em;text-transform:uppercase;color:#5b6470">Primary authority</p>
    <ul style="margin:0;padding-left:20px;font-size:16px;line-height:1.9">
      {%- for a in authorities %}
      <li><a href="{{ a.url }}" rel="noopener" target="_blank">{{ a.cite }}</a></li>
      {%- endfor %}
    </ul>
    <p style="margin:12px 0 0;font-size:14px;line-height:1.6;color:#5b6470">Read the law itself, not only our summary of it. Every citation above was checked against the official source before publication &mdash; see our <a href="/editorial-standards/">editorial standards</a>.</p>
  </section>
  {% endif %}
  {% if myHub %}
  <section class="hub-links" style="margin:36px 0 0;padding:20px;border:1px solid rgba(20,24,31,.14);border-radius:6px">
    <p style="margin:0 0 10px;font-size:14px;letter-spacing:.04em;text-transform:uppercase;color:#5b6470">More in {{ myHub.label }}</p>
    <ul style="margin:0;padding-left:20px;font-size:16px;line-height:1.85">
      {%- set shown = 0 -%}
      {%- for p in collections.posts -%}
        {%- if p.data.hub == hub and p.url != page.url and shown < 4 -%}
          {%- set shown = shown + 1 -%}
      <li><a href="{{ p.url }}">{{ p.data.title }}</a></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    <p style="margin:12px 0 0;font-size:15px"><a href="/topics/{{ myHub.slug }}/">All {{ myHub.label }} articles &rarr;</a></p>
  </section>
  {% endif %}
  <div class="post-cta">
    <strong>Need a motion prepared?</strong> Talk to our team about your situation.
    Call <a href="tel:+17864085073">786-408-5073</a> (Mon–Fri 9–6, Sat 10–2 EST) or email
    <a href="mailto:info@prisonerlegalaid.com">info@prisonerlegalaid.com</a>.
  </div>
</article>
